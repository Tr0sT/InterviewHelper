{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interview Helper",
  "version": "0.1.0",
  "identifier": "rocks.nuclearband.interviewhelper",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Interview Helper", "width": 1440, "height": 960, "minWidth": 980, "minHeight": 650 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'" }
  },
  "bundle": { "active": false }
}
